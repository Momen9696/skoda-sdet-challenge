{
  "name": "skoda-parts-e2e",
  "version": "1.0.0",
  "description": "Enterprise Playwright + TypeScript automation framework for skoda-parts.com",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:smoke": "playwright test --grep @smoke",
    "test:search": "playwright test --grep @search",
    "test:checkout": "playwright test --grep @checkout",
    "test:regression": "playwright test --grep @regression",
    "report": "allure generate ./allure-results --clean -o ./allure-report && allure open ./allure-report",
    "report:serve": "allure serve ./allure-results",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps chromium firefox webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "allure-commandline": "^2.34.0",
    "allure-playwright": "^3.2.0",
    "dotenv": "^16.5.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-playwright": "^2.2.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.32.0"
  },
  "engines": {
    "node": ">=20"
  }
}
