# Application under test
BASE_URL=https://www.skoda-dily.cz

# Execution profile: local | ci | staging
TEST_ENV=local

# Browser: chromium | firefox | webkit | all
BROWSER=chromium

# Parallel workers (CI often uses 2–4)
WORKERS=4

# Timeouts (milliseconds)
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=45000
EXPECT_TIMEOUT=10000

# Retries (CI default: 2, local: 0)
RETRIES=0

# Artifacts: on | off | retain-on-failure
TRACE=on-first-retry
SCREENSHOT=only-on-failure
VIDEO=retain-on-failure

# Reporting
ALLURE_RESULTS_DIR=allure-results

# API layer (extensibility — not required for current UI suite)
API_BASE_URL=https://www.skoda-dily.cz
API_TIMEOUT=30000
